                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "group",
                  "value": "<string>",
                  "description": "Filter configuration parameters by group name."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "serverId",
                  "description": "(Required) The unique identifier of the SAP ASE server instance."
                },
                {
                  "description": "SAP ASE server hostname",
                  "type": "any",
                  "value": "{{server}}",
                  "key": "server"
