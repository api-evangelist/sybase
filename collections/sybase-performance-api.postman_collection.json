                "servers",
                ":serverId",
                "performance"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "interval",
                  "value": "60",
                  "description": "The sampling interval in seconds for performance data collection."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "serverId",
                  "description": "(Required) The unique identifier of the SAP ASE server instance."
                },
                {
                  "description": "SAP ASE server hostname",
                  "type": "any",
                  "value": "{{server}}",
                  "key": "server"
