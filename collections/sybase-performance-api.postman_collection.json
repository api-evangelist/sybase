          "name": "Get Performance Metrics",
          "request": {
            "name": "Get Performance Metrics",
            "description": {
              "content": "Retrieves current performance metrics for the SAP ASE server including CPU utilization, disk I/O statistics, cache hit ratios, lock activity, and network throughput. Equivalent to data available from sp_sysmon.",
              "type": "text/plain"
            },
